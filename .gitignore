# Runtime artifacts written by IFileStorage at execution time: per-step screenshots,
# DOM snapshots and uploaded requirement documents. Regenerated on every run, so they are
# machine state rather than source. Ignoring the directory (not the file extensions) keeps
# real app assets such as frontend/public and frontend/src/assets committable.
src/ATIP.Api/storage/

# Playwright artifacts
.playwright-mcp/

# Logs
*.log

# OS
.DS_Store

# local developer secrets
src/ATIP.Api/appsettings.Development.json
