# Auth0 configuration for the SPA.
# Copy this file to `.env` (or `.env.local`) and fill in your values, then restart `npm run dev`.
#
VITE_AUTH0_DOMAIN=dev-igvssogoc8glgn1c.us.auth0.com
VITE_AUTH0_CLIENT_ID=ZOnXv00I6xizUdkJeU50eWDcHap7YcA6
# The API Identifier from Auth0 (Applications -> APIs). Must match the backend "Auth0:Audience".
VITE_AUTH0_AUDIENCE=https://qanexus-api
#
# In the Auth0 application settings:
#   Allowed Callback URLs:  http://localhost:5173/login/callback
#   Allowed Logout URLs:    http://localhost:5173/login
#   Allowed Web Origins:    http://localhost:5173
#   Application Login URI:  (leave blank - it must be https)
#
# Create an API (Applications -> APIs) with Identifier https://qanexus-api (RS256) so Auth0 issues
# JWT access tokens for it. Add a Login Action so the access token carries email/name:
